# Cutting Edge v2 — AI engine environment
#
# Copy this file to `ai-engine/.env` and fill in your OpenRouter key to enable
# the cloud AI features (.env is git-ignored). Without a key the app still
# boots; /ai/chat and related endpoints report an "offline" outcome.
#
# Where to get a key: https://openrouter.ai/keys (free tier is enough for v1.0).

OPENROUTER_API_KEY=

# Optional — defaults are shown.
# CE_HOST=127.0.0.1
# CE_PORT=8001
