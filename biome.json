{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "ignore": ["**/node_modules", "**/.next", "**/out", "**/dist", "**/target", "**/playwright-report", "**/test-results", "**/.turbo", "**/next-env.d.ts", "pnpm-lock.yaml", "**/*.junit.xml"]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "es5" } },
  "json": { "formatter": { "enabled": true } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": { "noExplicitAny": "error", "noConsoleLog": "off" },
      "style": { "noNonNullAssertion": "error", "useImportType": "error" },
      "correctness": { "noUnusedImports": "error", "noUnusedVariables": "error", "useExhaustiveDependencies": "error" },
      "a11y": { "recommended": true }
    }
  },
  "overrides": [
    { "include": ["scripts/**/*.js", "scripts/**/*.mjs", "apps/desktop/scripts/**"], "linter": { "rules": { "suspicious": { "noConsoleLog": "off" } } } }
  ]
}
