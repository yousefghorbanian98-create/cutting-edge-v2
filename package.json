{
  "name": "cutting-edge-v2",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome ci apps/desktop/src apps/desktop/tests packages scripts",
    "format": "biome format --write apps/desktop/src apps/desktop/tests packages scripts",
    "gate:static": "python scripts/gate.py --stage static",
    "design:audit": "python scripts/design_audit.py apps/desktop/src --strict",
    "gate:unit": "python scripts/gate.py --stage unit",
    "gate:real": "python scripts/gate.py --stage real",
    "gate:e2e": "python scripts/gate.py --stage e2e",
    "prepare": "lefthook install || exit 0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "lefthook": "1.10.11",
    "turbo": "2.11.2"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.28"
    }
  }
}
