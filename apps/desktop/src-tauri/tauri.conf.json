{
  "tauri": {
    "productName": "Cutting Edge V2",
    "version": "1.0.0",
    "identifier": "com.cuttingedge.v2",
    "bundle": {
      "active": true,
      "targets": ["nsis", "app"],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.ico",
        "icons/icon.png"
      ]
    },
    "windows": [
      {
        "title": "Cutting Edge V2",
        "contentProtected": true,
        "resizable": true,
        "fullscreen": false,
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 768
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; script-src 'self'; style-src 'self'"
    }
  }
}