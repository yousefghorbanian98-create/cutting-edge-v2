{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cutting Edge",
  "version": "2.0.0",
  "identifier": "com.cuttingedge.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cutting Edge",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#09090b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Video",
    "shortDescription": "AI video editor for sports & fitness creators",
    "longDescription": "Cutting Edge — offline-first desktop video editor with beat sync, style match, AI assistant and a natural muscle enhancer. Persian and English.",
    "publisher": "Cutting Edge v2 contributors",
    "copyright": "Copyright (c) 2026 Cutting Edge v2 contributors — MIT",
    "licenseFile": "../../../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Persian"],
        "displayLanguageSelector": true
      }
    }
  }
}
