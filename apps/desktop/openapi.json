  "components": {
    "schemas": {
      "Body_post_beat_sync": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_post_beat_sync"
      },
      "Body_post_mood_dna": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_post_mood_dna"
      },
      "Body_post_muscle_enhance": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "intensity": {
            "type": "number",
            "title": "Intensity",
            "default": 0.6
          },
          "preset": {
            "type": "string",
            "title": "Preset",
            "default": "natural_gym"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_post_muscle_enhance"
      },
      "Body_post_style_compare": {
        "properties": {
          "reference": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Reference"
          },
          "source": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Source"
          }
        },
        "type": "object",
        "required": [
          "reference",
          "source"
        ],
        "title": "Body_post_style_compare"
      },
      "Body_post_viral_cut": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "target_duration": {
            "type": "integer",
            "title": "Target Duration",
            "default": 30
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_post_viral_cut"
      },
      "ChatReq": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          },
          "language": {
            "type": "string",
            "title": "Language",
            "default": "fa"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatReq"
      },
      "ExportBody": {
        "properties": {
          "w": {
            "type": "integer",
            "title": "W"
          },
          "h": {
            "type": "integer",
            "title": "H"
          },
          "fps": {
            "type": "integer",
            "title": "Fps"
          },
          "codec": {
            "type": "string",
            "title": "Codec"
          },
          "clips": {
            "items": {
              "type": "object"
            },
            "type": "array",
            "title": "Clips"
          },
          "output_name": {
            "type": "string",
            "title": "Output Name",
            "default": "export.mp4"
          },
          "overwrite": {
            "type": "boolean",
            "title": "Overwrite",
            "default": false
          },
          "crf": {
            "type": "integer",
            "title": "Crf",
            "default": 23
          },
          "pace": {
            "type": "string",
            "title": "Pace",
            "default": "fast"
          },
          "mix": {
            "type": "string",
            "title": "Mix",
            "default": "copy"
          },
          "audio_codec": {
            "type": "string",
            "title": "Audio Codec",
            "default": "aac"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "w",
          "h",
          "fps",
          "codec"
        ],
        "title": "ExportBody"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobAccepted": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "status"
        ],
        "title": "JobAccepted",
        "description": "POST of a heavy endpoint. Poll GET /jobs/{job_id} for the result."
      },
      "JobView": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "progress": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Progress"
          },
          "percent": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Percent"
          },
          "eta_s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Eta S"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "result": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "output_filename": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Filename"
          },
          "partial_removed": {
            "type": "boolean",
            "title": "Partial Removed",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "progress",
          "percent"
        ],
        "title": "JobView"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VoiceReq": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "VoiceReq"
      }
    }
  }
